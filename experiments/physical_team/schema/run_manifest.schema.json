{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Physical-team run manifest",
  "type": "object",
  "required": [
    "schema_version", "run_id", "method", "team_size", "site_id",
    "arena_id", "trial_id", "operator", "created_utc", "git_commit",
    "checkpoint_sha256", "config_sha256", "ground_truth_source", "robots"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 3},
    "method": {"type": "string", "minLength": 1},
    "team_size": {"enum": [2, 3, 5]},
    "site_id": {"type": "string", "minLength": 1},
    "arena_id": {"type": "string", "minLength": 1},
    "trial_id": {"type": "integer", "minimum": 1},
    "operator": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ground_truth_source": {
      "enum": ["motion_capture", "overhead_tracking", "surveyed_fiducials"]
    },
    "robots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "namespace", "host", "base_serial", "lidar_serial"],
        "properties": {
          "id": {"type": "integer", "minimum": 0},
          "namespace": {"type": "string", "pattern": "^/robot_[0-9]+$"},
          "host": {"type": "string", "minLength": 1},
          "base_serial": {"type": "string", "minLength": 1},
          "lidar_serial": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
