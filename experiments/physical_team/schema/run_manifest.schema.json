{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Physical-team run manifest",
  "type": "object",
  "required": [
    "schema_version", "run_id", "method", "team_size", "site_id",
    "arena_id", "trial_id", "operator", "created_utc", "git_commit",
    "checkpoint_sha256", "config_sha256", "ground_truth_source",
    "ground_truth_reference", "robots", "collection_mode", "evidence_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 3},
    "method": {"type": "string", "minLength": 1},
    "team_size": {"enum": [2, 3, 5]},
    "site_id": {"type": "string", "minLength": 1},
    "arena_id": {"type": "string", "minLength": 1},
    "trial_id": {"type": "integer", "minimum": 1},
    "operator": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ground_truth_source": {
      "enum": ["motion_capture", "overhead_tracking", "surveyed_fiducials"]
    },
    "ground_truth_reference": {
      "type": "object",
      "required": [
        "calibration_id", "calibration_path", "calibration_sha256",
        "extrinsics_id", "extrinsics_path", "extrinsics_sha256",
        "uncertainty_translation_m", "uncertainty_yaw_deg"
      ],
      "properties": {
        "calibration_id": {"type": "string", "minLength": 1},
        "calibration_path": {"const": "evidence/reference_calibration.json"},
        "calibration_sha256": {
          "type": "string", "pattern": "^[0-9a-f]{64}$"
        },
        "extrinsics_id": {"type": "string", "minLength": 1},
        "extrinsics_path": {"const": "evidence/reference_extrinsics.json"},
        "extrinsics_sha256": {
          "type": "string", "pattern": "^[0-9a-f]{64}$"
        },
        "uncertainty_translation_m": {"type": "number", "minimum": 0},
        "uncertainty_yaw_deg": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "collection_mode": {"const": "physical"},
    "evidence_status": {"const": "unverified_pre_capture"},
    "campaign": {
      "type": "object",
      "required": [
        "campaign_id", "condition_id", "pair_id", "randomization_order",
        "start_pose_set_id", "network_profile", "campaign_plan_sha256",
        "network_profile_sha256"
      ],
      "properties": {
        "campaign_id": {"type": "string", "minLength": 3},
        "condition_id": {"enum": ["reference", "impaired"]},
        "pair_id": {"type": "string", "minLength": 1},
        "randomization_order": {"type": "integer", "minimum": 1},
        "start_pose_set_id": {"type": "string", "minLength": 1},
        "network_profile": {"type": "string", "minLength": 1}
        ,
        "campaign_plan_sha256": {
          "type": "string", "pattern": "^[0-9a-f]{64}$"
        },
        "network_profile_sha256": {
          "type": "string", "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "protocol_lock": {
      "type": "object",
      "required": [
        "stopping_rule_id", "motion_limits_id", "sensing_policy_id",
        "reference_timestamp_tolerance_ms"
      ],
      "properties": {
        "stopping_rule_id": {"type": "string", "minLength": 1},
        "motion_limits_id": {"type": "string", "minLength": 1},
        "sensing_policy_id": {"type": "string", "minLength": 1},
        "reference_timestamp_tolerance_ms": {
          "type": "number", "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    },
    "robots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "namespace", "host", "base_serial", "lidar_serial"],
        "properties": {
          "id": {"type": "integer", "minimum": 0},
          "namespace": {"type": "string", "pattern": "^/robot_[0-9]+$"},
          "host": {"type": "string", "minLength": 1},
          "base_serial": {"type": "string", "minLength": 1},
          "lidar_serial": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "notes": {"type": "string"}
  },
  "dependentRequired": {
    "campaign": ["protocol_lock"]
  },
  "additionalProperties": true
}
