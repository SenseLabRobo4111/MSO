{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Physical-team registration event",
  "type": "object",
  "required": [
    "schema_version", "event_id", "run_id", "timestamp_ns",
    "source_robot_id", "target_robot_id", "state", "estimate", "gate"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "minLength": 1},
    "parent_event_id": {"type": ["string", "null"]},
    "run_id": {"type": "string", "minLength": 3},
    "timestamp_ns": {"type": "integer", "minimum": 1},
    "source_robot_id": {"type": "integer", "minimum": 0},
    "target_robot_id": {"type": "integer", "minimum": 0},
    "state": {
      "enum": ["candidate", "accepted", "rejected", "committed", "recovered"]
    },
    "estimate": {
      "type": "object",
      "required": ["tx_m", "ty_m", "yaw_deg"],
      "properties": {
        "tx_m": {"type": "number"},
        "ty_m": {"type": "number"},
        "yaw_deg": {"type": "number"}
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["decision", "reason"],
      "properties": {
        "decision": {"enum": ["accept", "reject", "not_applicable"]},
        "reason": {"type": "string"},
        "score": {"type": ["number", "null"]},
        "threshold": {"type": ["number", "null"]},
        "support": {"type": ["integer", "null"], "minimum": 0},
        "inlier_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "overlap": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "map_revision_before": {"type": ["integer", "null"], "minimum": 0},
    "map_revision_after": {"type": ["integer", "null"], "minimum": 0},
    "map_hash_before": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "map_hash_after": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "recovery_verification": {
      "type": ["object", "null"],
      "required": [
        "invalidated_commit_event_id", "invalidated_revision",
        "invalidated_map_hash", "active_revision", "active_map_hash",
        "method", "verified_by", "evidence_path", "evidence_sha256"
      ],
      "properties": {
        "invalidated_commit_event_id": {"type": "string", "minLength": 1},
        "invalidated_revision": {"type": "integer", "minimum": 0},
        "invalidated_map_hash": {
          "type": "string", "pattern": "^[0-9a-f]{64}$"
        },
        "active_revision": {"type": "integer", "minimum": 0},
        "active_map_hash": {
          "type": "string", "pattern": "^[0-9a-f]{64}$"
        },
        "method": {
          "enum": ["rollback", "recompute", "pose_graph_reoptimisation"]
        },
        "verified_by": {"type": "string", "minLength": 1},
        "evidence_path": {
          "type": "string",
          "pattern": "^evidence/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.json$"
        },
        "evidence_sha256": {
          "type": "string", "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": ["accepted", "rejected", "committed", "recovered"]
          }
        }
      },
      "then": {
        "required": [
          "map_revision_before", "map_revision_after",
          "map_hash_before", "map_hash_after"
        ]
      }
    },
    {
      "if": {"properties": {"state": {"const": "accepted"}}},
      "then": {
        "properties": {
          "gate": {"properties": {"decision": {"const": "accept"}}}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "rejected"}}},
      "then": {
        "properties": {
          "gate": {"properties": {"decision": {"const": "reject"}}}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "recovered"}}},
      "then": {
        "required": ["parent_event_id", "recovery_verification"],
        "properties": {
          "parent_event_id": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "additionalProperties": true
}
