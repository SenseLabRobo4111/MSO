{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Post-recovery independently verified active map state",
  "type": "object",
  "required": [
    "schema_version", "run_id", "recovery_event_id", "parent_event_id",
    "source_robot_id", "target_robot_id", "observed_timestamp_ns",
    "active_revision", "active_map_hash", "method", "verified_by"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 3},
    "recovery_event_id": {"type": "string", "minLength": 1},
    "parent_event_id": {"type": "string", "minLength": 1},
    "source_robot_id": {"type": "integer", "minimum": 0},
    "target_robot_id": {"type": "integer", "minimum": 0},
    "observed_timestamp_ns": {"type": "integer", "minimum": 1},
    "active_revision": {"type": "integer", "minimum": 0},
    "active_map_hash": {
      "type": "string", "pattern": "^[0-9a-f]{64}$"
    },
    "method": {
      "enum": ["rollback", "recompute", "pose_graph_reoptimisation"]
    },
    "verified_by": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
