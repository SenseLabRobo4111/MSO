{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent reference transform joined to a registration event",
  "type": "object",
  "required": [
    "event_id", "timestamp_ns", "source_robot_id", "target_robot_id",
    "gt_tx_m", "gt_ty_m", "gt_yaw_deg", "source",
    "calibration_id", "calibration_sha256", "extrinsics_id",
    "extrinsics_sha256", "uncertainty_translation_m", "uncertainty_yaw_deg"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "timestamp_ns": {"type": "integer", "minimum": 1},
    "source_robot_id": {"type": "integer", "minimum": 0},
    "target_robot_id": {"type": "integer", "minimum": 0},
    "gt_tx_m": {"type": "number"},
    "gt_ty_m": {"type": "number"},
    "gt_yaw_deg": {"type": "number"},
    "source": {"enum": ["motion_capture", "overhead_tracking", "surveyed_fiducials"]},
    "calibration_id": {"type": "string", "minLength": 1},
    "calibration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extrinsics_id": {"type": "string", "minLength": 1},
    "extrinsics_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uncertainty_translation_m": {"type": "number", "minimum": 0},
    "uncertainty_yaw_deg": {"type": "number", "minimum": 0}
  },
  "additionalProperties": false
}
