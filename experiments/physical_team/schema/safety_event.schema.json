{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Physical-team safety event",
  "type": "object",
  "required": [
    "schema_version", "event_id", "run_id", "timestamp_ns", "robot_id",
    "event_type", "action", "detail"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 3},
    "timestamp_ns": {"type": "integer", "minimum": 1},
    "robot_id": {"type": ["integer", "null"], "minimum": 0},
    "event_type": {
      "enum": [
        "emergency_stop", "collision", "near_collision",
        "operator_intervention", "localisation_loss", "communication_loss",
        "planner_abort", "registration_reject", "registration_rollback", "other"
      ]
    },
    "action": {"type": "string", "minLength": 1},
    "detail": {"type": "string"},
    "resolved": {"type": ["boolean", "null"]}
  },
  "additionalProperties": true
}
